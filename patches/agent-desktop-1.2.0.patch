+    #[test]
+    fn the_shipped_client_disables_automatic_focus_before_returning_elements() {
+        use windows::Win32::UI::Accessibility::{IUIAutomation, IUIAutomation2};
+        use windows::core::Interface;
+        bootstrap();
+        let client = automation_client().expect("a client");
+        let raw: IUIAutomation = client.as_ref().clone();
+        let configured: IUIAutomation2 = raw.cast().expect("IUIAutomation2");
+        assert!(
+            !unsafe { configured.AutoSetFocus() }
+                .expect("the client exposes its automatic focus setting")
+                .as_bool(),
+            "semantic actions must not implicitly focus the target"
+        );
+    }
